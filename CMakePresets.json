{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/_deps"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug build with tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan and UBSan, no recover",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TICK_STORE_SANITIZE": "asan-ubsan"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TICK_STORE_SANITIZE": "tsan"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets with ASan and UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TICK_STORE_SANITIZE": "fuzz",
        "TICK_STORE_BUILD_TESTS": "OFF",
        "TICK_STORE_BUILD_TOOLS": "OFF",
        "TICK_STORE_BUILD_FUZZ": "ON"
      }
    },
    {
      "name": "bench",
      "displayName": "Optimised with -O3, no sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "bench", "configurePreset": "bench" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan-ubsan", "inherits": "base", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "bench", "inherits": "base", "configurePreset": "bench" }
  ]
}
