# Chosen for byte-level decoder code. The disabled checks are style rules that
# argue with fixed wire offsets, short conventional names, hand-laid byte tables
# or #pragma once, which every compiler we target supports. The rest of each
# group stays on. Warnings are errors, and any NOLINT carries its reason.
# IgnoreHeaders: macOS declares POSIX names in private headers. The portable
# spellings, <fcntl.h> and <unistd.h>, are the ones to include.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-pro-type-reinterpret-cast,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-slicing,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-trailing-comma,
  -readability-function-cognitive-complexity
WarningsAsErrors: '*'
HeaderFilterRegex: '(include/tick_store|src|tests/unit|fuzz)/.*'
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'sys/fcntl\.h;sys/_types/.*'
