 "group_table": {
  "rule": "a symbol goes to the first group with a pattern that matches it: name patterns are matched from the start of the function's qualified name, its return type and parameters dropped; dso against the shared object; level against perf's [k] or [.] mark",
  "groups": [
   {
    "name": "kernel_addresses",
    "what": "samples perf placed at a kernel address though only user mode was counted",
    "patterns": [
     "level: k"
    ]
   },
   {
    "name": "parse",
    "what": "ITCH framing and decoding",
    "patterns": [
     "name: tick_store::itch::"
    ]
   },
   {
    "name": "book_state",
    "what": "each message taken into the segment: the builder's per-order state, the reference map, the symbol table and the dispatch on each message's type",
    "patterns": [
     "name: tick_store::store::SegmentBuilder::State::",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?RefMap::",
     "name: tick_store::store::SymbolTable::",
     "name: tick_store::store::SegmentBuilder::add$",
     "name: tick_store::store::ItchStoreWriter::append$",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:column_form_plain|hot_fields)$",
     "name: tick_store::store::SegmentBuilder::records$",
     "name: std::(?:__1::)?__variant_detail::"
    ]
   },
   {
    "name": "segment_assembly",
    "what": "turning a full segment's messages into columns: the builder's finish, grouping, time bases, seek and maxima",
    "patterns": [
     "name: tick_store::store::SegmentBuilder::finish$",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:compute_seek|column_maxima|group_by_key|order_by_key|time_bases|time_residuals|column_form_\\w+)$"
    ]
   },
   {
    "name": "sort",
    "what": "the standard library's sorts",
    "patterns": [
     "name: std::(?:__1::)?(?:ranges::)?(?:__)?(?:introsort|bitset_partition|insertion_sort\\w*|partition_with_equals\\w*|pdqsort\\w*|sort\\w*|floyd_sift_down|sift_down|partial_sort\\w*|nth_element\\w*|stable_sort\\w*|merge\\w*)"
    ]
   },
   {
    "name": "pfor_encode",
    "what": "PFOR encoding, the dictionary's code streams included: width and scale search, packing, patches",
    "patterns": [
     "name: tick_store::codec::(?:\\(anonymous namespace\\)::)?(?:choose_width|encode_scaled|encode_block_with|encode_pfor\\w*|plan_vector|emit_vector|scale_candidates|pack_\\w+|append_words_le|append_patches)$",
     "name: tick_store::codec::BitWriter::"
    ]
   },
   {
    "name": "dictionary_encode",
    "what": "the dictionary encoder's own work, outside the PFOR it calls",
    "patterns": [
     "name: tick_store::codec::(?:\\(anonymous namespace\\)::)?(?:encode_dict\\w*|encode_ranked_\\w+|encode_sorted_mtf|huffman_lengths|scan_for_repeats)$"
    ]
   },
   {
    "name": "zstd",
    "what": "zstd and its entropy coders",
    "patterns": [
     "name: (?:ZSTD|HUF|FSE|HIST|ZSTDMT|POOL|ZDICT|ERR|XXH)\\w*",
     "name: tick_store::codec::(?:\\(anonymous namespace\\)::)?(?:encode|decode)_zstd_payload$"
    ]
   },
   {
    "name": "crc",
    "what": "CRC32C",
    "patterns": [
     "name: tick_store::store::.*crc32c"
    ]
   },
   {
    "name": "store_writer",
    "what": "the per-column driver, metadata and container writing",
    "patterns": [
     "name: tick_store::store::(?:ContainerWriter|ContainerLayout)::",
     "name: tick_store::store::ItchStoreWriter::(?:write_segment|finish|write_last)$",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:encode_column|encode_column_metadata|encode_store_header|code_pfor|code_values|pfor_options)$"
    ]
   },
   {
    "name": "containers",
    "what": "the standard library's vectors, strings and hash tables, as compiled into the binary: growth, copies, assignment",
    "patterns": [
     "name: std::(?:__1::)?(?:vector|basic_string|deque|unordered_map|__hash_table)<"
    ]
   },
   {
    "name": "memory",
    "what": "allocation and copies, where the C library's symbols resolve",
    "patterns": [
     "name: (?:malloc|free|calloc|realloc|cfree|_int_malloc|_int_free\\w*|_int_realloc|malloc_consolidate|sysmalloc|tcache\\w*|unlink_chunk\\w*|__libc_(?:malloc|free|calloc|realloc)|operator new|operator delete|__mem(?:move|cpy|set|cmp)\\w*|__mempcpy\\w*|mem(?:cpy|move|set|cmp)|mmap\\w*|munmap|brk|sbrk)(?:@plt)?$"
    ]
   },
   {
    "name": "libc",
    "what": "the C library, its addresses unresolved",
    "patterns": [
     "dso: libc\\.so"
    ]
   },
   {
    "name": "libcxx",
    "what": "the C++ library outside its sorts",
    "patterns": [
     "dso: libc\\+\\+(?:abi)?\\.so"
    ]
   },
   {
    "name": "tool",
    "what": "the command-line driver",
    "patterns": [
     "name: tick_store::harness::"
    ]
   },
   {
    "name": "unresolved",
    "what": "addresses with no symbol",
    "patterns": [
     "name: (?:0x[0-9a-f]+|\\[unknown\\])$"
    ]
   },
   {
    "name": "unmatched",
    "what": "symbols no pattern above matches, kept apart and never spread over the groups",
    "patterns": []
   }
  ]
 },
