   },
   {
    "name": "unresolved",
    "what": "addresses with no symbol",
    "patterns": [
     "name: (?:0x[0-9a-f]+|\\[unknown\\])$"
    ]
   },
   {
    "name": "unmatched",
    "what": "symbols no pattern above matches, kept apart and never spread over the groups",
    "patterns": []
   }
  ]
 },
