    ]
   },
   {
    "name": "time_bases",
    "what": "timestamps from their time bases",
    "patterns": [
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:time_bases|time_residuals|each_with_base)$"
    ]
   },
   {
    "name": "scan_and_rows",
    "what": "the query engine's scan and its rows",
    "patterns": [
     "name: tick_store::store::ItchQuery::",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:scan_run|locate_segment|all_segment|all_positions|open_scan_columns|plain_segment|open_stocks|stock_of|count_whole_segment|exact_segment|zone_range|file_range|seed_before|may_hold|bit_of|rank_of)$"
    ]
   },
   {
    "name": "column_decode",
    "what": "the column and block decode drivers",
    "patterns": [
     "name: tick_store::codec::(?:\\(anonymous namespace\\)::)?(?:decode_column|read_block_header|check_block_values|reserve_for_block)$",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:decode_column|column_block_decoder|block_decoder|unwrap_column|widen)$"
    ]
   },
   {
    "name": "store_open",
    "what": "opening the store: container, footer, metadata and symbols",
    "patterns": [
     "name: tick_store::store::(?:ItchStoreReader|ContainerReader|MappedFile)::",
     "name: tick_store::store::(?:\\(anonymous namespace\\)::)?(?:parse_store_header|parse_column_metadata|parse_seek|check_run_directory)$",
     "name: tick_store::store::SymbolTable::"
    ]
   },
   {
    "name": "crc",
    "what": "CRC32C",
    "patterns": [
     "name: tick_store::store::.*crc32c"
    ]
   },
   {
    "name": "answer_io",
    "what": "reading requests and writing answers",
    "patterns": [
     "name: tick_store::harness::",
     "name: std::(?:__1::)?(?:__format\\w*|vformat\\w*|format\\w*|__formatter\\w*|basic_ostream|basic_istream|getline|__put_character_sequence)"
    ]
   },
   {
    "name": "containers",
    "what": "the standard library's vectors, strings and hash tables, as compiled into the binary: growth, copies, assignment",
    "patterns": [
     "name: std::(?:__1::)?(?:vector|basic_string|deque|unordered_map|__hash_table)<"
    ]
   },
   {
    "name": "memory",
    "what": "allocation and copies, where the C library's symbols resolve",
    "patterns": [
     "name: (?:malloc|free|calloc|realloc|cfree|_int_malloc|_int_free\\w*|_int_realloc|malloc_consolidate|sysmalloc|tcache\\w*|unlink_chunk\\w*|__libc_(?:malloc|free|calloc|realloc)|operator new|operator delete|__mem(?:move|cpy|set|cmp)\\w*|__mempcpy\\w*|mem(?:cpy|move|set|cmp)|mmap\\w*|munmap|brk|sbrk)(?:@plt)?$"
    ]
   },
