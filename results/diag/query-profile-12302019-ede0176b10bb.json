    "name": "pfor_decode",
    "what": "PFOR block decode",
    "patterns": [
     "name: tick_store::codec::(?:\\(anonymous namespace\\)::)?decode_pfor\\w*$"
    ]
   },
   {
    "name": "unpack_kernels",
    "what": "the unpack, delta and add kernels of every kernel set",
    "patterns": [
     "name: tick_store::codec::simd::",
     "name: tick_store::codec::(?:unpack_vector|unpack_linear)$"
    ]
   },
   {
    "name": "zstd",
    "what": "zstd and its entropy coders",
    "patterns": [
     "name: (?:ZSTD|HUF|FSE|HIST|ZSTDMT|POOL|ZDICT|ERR|XXH)\\w*",
